# Every source file includes its module precompiled header explicitly, and CMake
# force-includes the same header for the build, so clangd's include cleaner
# always reports the explicit include as unused.
Diagnostics:
  Includes:
    IgnoreHeader:
      - pch\.hh
---
# Commands for headers are interpolated from a neighbouring .cc and clangd drops
# MSVC's /std:c++23 while doing so, leaving clang-cl at its C++14 default. -Xclang
# reaches the frontend under any driver mode.
If:
  PathMatch: .*\.(hh|hxx)
CompileFlags:
  Add: [-Xclang, -std=c++23]
