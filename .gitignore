## Ignore some files generated by VSCode/VS
## except some things we might actually need
/.vs/*
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/launch.json

## Ignore build and output directories with
## everything build process generates
/.cache/
/.cache/*
/build/
/build/*
/dist/
/dist/*
/site/
/site/*
/*.old/
/*.old/**

## Ignore generated files and everything else
## that would be emitted by running the game
*.bak
*.log
*.ini
*.obj
*.dll
*.exe
*.lib
*.so
*.a
*.o
*.pyc
*.glb
*.blend1

## Ignore stuff that IDEs may generate
CMakeSettings.json
CMakeUserPresets.json
