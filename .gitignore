## Ignore some files generated by VSCode
## except some things we might actually need
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/launch.json

## Ignore build and output directories with
## everything build process generates
/build/
/build/*
/output/
/output/*

## Ignore generated files and everything else
## that would be emitted by running the game
*.bak
*.log
*.ini
*.obj
*.dll
*.exe
*.lib
*.so
*.a
*.o
*.pyc
*.glb
*.blend1
